# 复制为 .env 或 export 到 shell

export LLM_API_KEY=sk-你的deepseek密钥
export LLM_BASE_URL=https://api.deepseek.com
export LLM_MODEL=deepseek-flash

# 非空时把收发的 JSON 打到 stderr
export LLM_DEBUG=1

# ---------------------------------------------------------------
# 关于 Responses API（02/04/06）
#
# DeepSeek 提供 /responses，六节都可以直接运行。
# 它的实现不含服务端状态：previous_response_id / store / conversation
# 会被静默忽略，请求仍返回 200，但上下文不接续。
#
# 06-responses-multiturn 会检测该行为，并给出不依赖它的替代写法。
#
# 如需使用服务端状态，切换到支持该参数的端点：
# export LLM_BASE_URL=https://api.openai.com/v1
# export LLM_API_KEY=sk-你的openai密钥
# export LLM_MODEL=gpt-4o-mini
# ---------------------------------------------------------------
